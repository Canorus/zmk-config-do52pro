#include <physical_layouts.dtsi>

/ {
    default_transform0: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <6>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
            RC(4,0) RC(4,1)                     RC(4,4) RC(4,5)  RC(4,6) RC(4,7)                 RC(4,10) RC(4,11)
                                      RC(5,5) RC(5,3) RC(5,2) RC(5,1) RC(5,4)
                                      RC(5,7) RC(5,8) RC(5,10) RC(5,9) RC(5,6)
        >;
    };

    physical_layout0: physical_layout0 {
        compatible = "zmk,physical-layout";
        display-name = "DO52Pro TP";
        kscan = <&kscan0>;
        transform = <&default_transform0>;
        keys =
            <&key_physical_attrs 100 100    0 100 0 0 0>,
            <&key_physical_attrs 100 100  100  80 0 0 0>,
            <&key_physical_attrs 100 100  200  50 0 0 0>,
            <&key_physical_attrs 100 100  300  30 0 0 0>,
            <&key_physical_attrs 100 100  400  50 0 0 0>,
            <&key_physical_attrs 100 100  500  80 0 0 0>,
            <&key_physical_attrs 100 100 1500  80 0 0 0>,
            <&key_physical_attrs 100 100 1600  50 0 0 0>,
            <&key_physical_attrs 100 100 1700  30 0 0 0>,
            <&key_physical_attrs 100 100 1800  50 0 0 0>,
            <&key_physical_attrs 100 100 1900  80 0 0 0>,
            <&key_physical_attrs 100 100 2000 100 0 0 0>,

            <&key_physical_attrs 100 100    0 200 0 0 0>,
            <&key_physical_attrs 100 100  100 180 0 0 0>,
            <&key_physical_attrs 100 100  200 150 0 0 0>,
            <&key_physical_attrs 100 100  300 130 0 0 0>,
            <&key_physical_attrs 100 100  400 150 0 0 0>,
            <&key_physical_attrs 100 100  500 180 0 0 0>,
            <&key_physical_attrs 100 100 1500 180 0 0 0>,
            <&key_physical_attrs 100 100 1600 150 0 0 0>,
            <&key_physical_attrs 100 100 1700 130 0 0 0>,
            <&key_physical_attrs 100 100 1800 150 0 0 0>,
            <&key_physical_attrs 100 100 1900 180 0 0 0>,
            <&key_physical_attrs 100 100 2000 200 0 0 0>,

            <&key_physical_attrs 100 100    0 300 0 0 0>,
            <&key_physical_attrs 100 100  100 280 0 0 0>,
            <&key_physical_attrs 100 100  200 250 0 0 0>,
            <&key_physical_attrs 100 100  300 230 0 0 0>,
            <&key_physical_attrs 100 100  400 250 0 0 0>,
            <&key_physical_attrs 100 100  500 280 0 0 0>,
            <&key_physical_attrs 100 100 1500 280 0 0 0>,
            <&key_physical_attrs 100 100 1600 250 0 0 0>,
            <&key_physical_attrs 100 100 1700 230 0 0 0>,
            <&key_physical_attrs 100 100 1800 250 0 0 0>,
            <&key_physical_attrs 100 100 1900 280 0 0 0>,
            <&key_physical_attrs 100 100 2000 300 0 0 0>,

            <&key_physical_attrs 100 100    0 400 0 0 0>,
            <&key_physical_attrs 100 100  100 380 0 0 0>,
            <&key_physical_attrs 100 100  200 350 0 0 0>,
            <&key_physical_attrs 100 100  300 330 0 0 0>,
            <&key_physical_attrs 100 100  400 350 0 0 0>,
            <&key_physical_attrs 100 100  500 380 0 0 0>,
            <&key_physical_attrs 100 100 1500 380 0 0 0>,
            <&key_physical_attrs 100 100 1600 350 0 0 0>,
            <&key_physical_attrs 100 100 1700 330 0 0 0>,
            <&key_physical_attrs 100 100 1800 350 0 0 0>,
            <&key_physical_attrs 100 100 1900 380 0 0 0>,
            <&key_physical_attrs 100 100 2000 400 0 0 0>,

            <&key_physical_attrs 100 100    0 500 0 0 0>,
            <&key_physical_attrs 100 100  100 500 0 0 0>,
            <&key_physical_attrs 100 100  400 500 0 0 0>,
            <&key_physical_attrs 100 100  500 500 0 0 0>,
            <&key_physical_attrs 100 100 1500 500 0 0 0>,
            <&key_physical_attrs 100 100 1600 500 0 0 0>,
            <&key_physical_attrs 100 100 1900 500 0 0 0>,
            <&key_physical_attrs 100 100 2000 500 0 0 0>,

            <&key_physical_attrs 50 50  700 400 0 0 0>,
            <&key_physical_attrs 50 50  800 500 0 0 0>,
            <&key_physical_attrs 50 50  800 400 0 0 0>,
            <&key_physical_attrs 50 50  800 300 0 0 0>,
            <&key_physical_attrs 50 50  900 400 0 0 0>,
            <&key_physical_attrs 50 50 1100 400 0 0 0>,
            <&key_physical_attrs 50 50 1200 500 0 0 0>,
            <&key_physical_attrs 50 50 1300 400 0 0 0>,
            <&key_physical_attrs 50 50 1200 300 0 0 0>,
            <&key_physical_attrs 50 50 1200 400 0 0 0>;
    };
};
